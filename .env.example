# Copia este archivo como .env.local y coloca tus credenciales reales.
# Las encuentras en: Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-CLAVE-ANONIMA

# URL pública del sitio, sin barra final. Se usa para las URLs absolutas de
# canonical, Open Graph, JSON-LD, sitemap y robots. En Vercel colocar el
# dominio público (ej. https://destinopaisa.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
